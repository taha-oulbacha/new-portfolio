# ── Server ────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# Comma-separated list of sites allowed to POST leads.
CORS_ORIGINS=https://taha-oulbacha.com,https://www.taha-oulbacha.com

# Public URL of THIS api, used for links inside emails.
# Railway sets RAILWAY_PUBLIC_DOMAIN for you, so you can leave this blank there.
PUBLIC_URL=

# ── Database ──────────────────────────────────────────────────────────
# Railway gives you MYSQL_URL — paste it here and leave the parts blank.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=portfolio

# ── Auth ──────────────────────────────────────────────────────────────
# openssl rand -hex 48
JWT_SECRET=change-me-to-a-long-random-string

# Creates the FIRST admin account on boot, only when none exists yet.
# Handy on a fresh deploy where you have no shell. Safe to leave set —
# it never overwrites an existing account.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Cookie lifetime in days
SESSION_DAYS=7

# ── Optional: email me each new lead ─────────────────────────────────
# Leave SMTP_HOST empty to disable notifications entirely.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Portfolio <no-reply@taha-oulbacha.com>"
MAIL_TO=taha.oulbacha07@gmail.com
